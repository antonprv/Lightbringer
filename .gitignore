# Visual Studio 2015 user specific files
src/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
src/SourceArt/**/*.png
src/SourceArt/**/*.tga

# Binary Files
src/Binaries/*
src/Plugins/**/Binaries/*

# Builds
src/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!src/Build/*/
src/Build/*/**
!src/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!src/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
src/Saved/*

# Compiled source files for the engine to use
src/Intermediate/*
src/Plugins/**/Intermediate/*

# Cache files for the editor to use
src/DerivedDataCache/*

# Ignore everything in Content
src/Content/*

# Re-include Blueprints, Maps and Input directories
!src/Content/Blueprints/
!src/Content/Maps/
!src/Content/Input/

# Re-include all contents under Blueprints, Maps and Input
!src/Content/Blueprints/**/*
!src/Content/Maps/**/*
!src/Content/Input/**/*

src/Package/*
src/Saved/*
src/Staging/*
src/Plugins/vc-ue-extensions
src/Plugins/vc-ue-extensions/*
src/Plugins/vc-ue-extensions/*/*
src/Plugins/FMODStudio
src/Plugins/FMODStudio/*
src/Plugins/FMODStudio/*/*
src/Plugins/FMODStudioNiagara
src/Plugins/FMODStudioNiagara/*
src/Plugins/FMODStudioNiagara/*/*
enc_temp_folder/*
ParagonMurdock/*
ParagonWraith/*